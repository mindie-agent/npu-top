# Copy to .env (ignored by Git) or export before `npu-top serve`.

# Local-only listener. Keep NFM_BIND on loopback unless you add an explicit access layer.
NFM_BIND=127.0.0.1
NFM_PORT=8788

# No active browser: collect fast host/NPU metrics every 120 seconds.
NFM_IDLE_INTERVAL_SECONDS=120
# Never persist high-frequency interactive samples faster than this interval.
NFM_HISTORY_INTERVAL_SECONDS=30
# Disk, mounts and Docker are intentionally collected less frequently.
NFM_INFRA_INTERVAL_SECONDS=60
NFM_RETENTION_DAYS=90
NFM_MAX_WORKERS=8
NFM_SSH_TIMEOUT_SECONDS=12
# Idle driver overhead on A3-class devices is typically around 6 GB per die.
NFM_HBM_BUSY_THRESHOLD_MB=8192
# NFM_STATE_DIR=/absolute/path/to/private/state

# ---------------------------------------------------------------------------
# Optional host sources. npu-top does not search the filesystem or Git for
# these; every path must be given explicitly. Separate multiple paths with the
# platform path separator (":" on Linux/macOS, ";" on Windows).
#
# JSON files shaped like {"machines": [{"alias": "...", "host": {"ip": "...",
# "port": 22, "user": "root", "machine_type": "A3"}}]}. Only the host
# endpoint fields are read. Hosts listed here are imported as active.
# NFM_INVENTORY_FILES=/absolute/path/to/machine-inventory.json
#
# Plain-text host pools, one host per line; only the first whitespace-separated
# field is read. Hosts that appear only here get the derived low-priority tag.
# NFM_HOST_POOL_FILES=/absolute/path/to/hosts.txt
#
# Password onboarding works by default using the bundled SSH_ASKPASS helper.
# Enter hosts and one-time passwords in the console; no bootstrap setting or
# sshpass installation is needed. Passwords stay in request/child-process memory.
# An optional external command overrides the built-in installer for custom auth.
# Its password arrives on stdin. Placeholders: {host} {port} {user}
# {public_key_file} {python}. Exit 0 means installed; exit 77 means auth rejected
# before any remote write. Other failures have an unknown outcome and are not
# automatically retried. NFM_BOOTSTRAP_COMMAND is a legacy alias.
# MINDIE_TOP_BOOTSTRAP_COMMAND={python} /absolute/path/to/bootstrap.py --host {host} --host-port {port} --user {user} --public-key-file {public_key_file} --password-stdin

# Main database cap; WAL and logs are additional. History is aggregated every 15 minutes.
NFM_SQLITE_MAX_MB=1024
